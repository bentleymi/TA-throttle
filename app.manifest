{
  "schemaVersion": "2.0.0",
  "info": {
    "title": "CPU Frequency & Throttle Add-on (cpufreq sysfs + thermal throttle)",
    "id": {
      "group": null,
      "name": "TA-throttle",
      "version": "1.0.11"
    },
    "author": [
      {
